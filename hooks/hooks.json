{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run-index-hook.sh\" post-tool-use",
            "timeout": 120,
            "statusMessage": "refreshing code index after tool use"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run-index-hook.sh\" session-start",
            "timeout": 120,
            "statusMessage": "refreshing code index on session start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run-index-hook.sh\" user-prompt-submit",
            "timeout": 120,
            "statusMessage": "refreshing code index on prompt submit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run-index-hook.sh\" stop",
            "timeout": 120,
            "statusMessage": "refreshing code index on stop"
          }
        ]
      }
    ]
  }
}
