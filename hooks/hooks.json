{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${PLUGIN_ROOT}/scripts/run-index-hook.ts\" pre-tool-use",
            "timeout": 120,
            "statusMessage": "refreshing code index before tool use"
          }
        ]
      }
    ],
    "PermissionRequest": [
